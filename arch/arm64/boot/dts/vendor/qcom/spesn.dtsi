#include "khaje-idp.dtsi"

&dsi_td4330_truly_v2_video {
	/delete-property/ qcom,esd-check-enabled;
};

&dsi_td4330_truly_v2_cmd {
	/delete-property/ qcom,esd-check-enabled;
};

&dsi_nt36672e_fhd_plus_90hz_video {
	/delete-property/ qcom,esd-check-enabled;
};

&dsi_nt36672e_fhd_plus_120hz_video {
	/delete-property/ qcom,esd-check-enabled;
};

&qupv3_se2_i2c {
	synaptics_tcm@20 {
		status = "disabled";
	};

	novatek@62 {
		status = "disabled";
	};
};

&qupv3_se4_2uart {
	status = "disabled";
};

/* Spes NFC */
&qupv3_se4_i2c {
	status = "ok";
	qcom,clk-freq-out = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	st_st21nfc@8 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		st,irq-gpios = <&tlmm 70 0>;
		st,reset-gpios = <&tlmm 69 0>;
		st,clkreq-gpios = <&tlmm 71 0>;
		interrupt-parent = <&tlmm>;
		interrupts = <70 0>;
		interrupt-names = "nfc_irq";
		clock-names = "nfc_ref_clk";
		st,clk_pinctrl;
	};
};

&tlmm {
	/* RT1711H - TCPC */
	rt1711h_int_n: rt1711h_int_n {
		mux {
			pins = "gpio93";
			function = "gpio";
		};

		config {
			pins = "gpio93";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	/* BQ-CHARGER */
	bq2589x_int_default: bq2589x_int_default {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	/* sc8551-charger */
	sc8551_int_default: sc8551_int_default {
		mux {
			pins = "gpio84";
			function = "gpio";
		};

		config {
			pins = "gpio84";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	/* Onewire */
	onewire_gpio_active: onewire_gpio_active {
		mux {
			pins = "gpio108";
			function = "gpio";
		};

		config {
			pins = "gpio108";
			drive-strength = <16>;
			bias-pull-up;
			output-high;
		};
	};

	onewire_gpio_sleep: onewire_gpio_sleep {
		mux {
			pins = "gpio108";
			function = "gpio";
		};

		config {
			pins = "gpio108";
			drive-strength = <16>;
			bias-pull-down;
			input-enable;
		};
	};
};

&qupv3_se1_i2c {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	/* TCPC: Richtek RT1715 Type-C PD Controller */
	rt1715@4e {
		compatible = "richtek,rt1715";
		reg = <0x4e>;
		status = "okay";
		tcpc-dual,supported_modes = <0>;
		rt-tcpc,name = "type_c_port0";
		/* 0: Unknown, 1: SNK, 2: SRC, 3: DRP, 4: Try.SRC, 5: Try.SNK */
		rt-tcpc,role_def = <5>;
		/* 0: Default, 1: 1.5A, 2: 3.0A */
		rt-tcpc,rp_level = <0>;
		/* 0: Never, 1: Always, 2: EMarkOnly, 3: StartOnly */
		rt-tcpc,vconn_supply = <1>;
		rt1711hpd,intr-gpios = <&tlmm 93 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_int_n>;

		pd-data {
			pd,vid = <0x29cf>;
			pd,pid = <0x1711>;
			pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00];
			pd,mfrs = "RichtekTCPC";
			/*
			 * VSAFE5V = 0x00, MAX_POWER = 0x01, CUSTOM = 0x02
			 * MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
			 * MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
			 */
			pd,charging_policy = <0x31>;

			/*
			 * Fixed 5V, 500 mA = <0x00019032>
			 * Fixed 5V, 1A = <0x00019064>
			 * Fixed 5V, 1.5A = <0x00019096>
			 * Fixed 5V, 2A = <0x000190c8>
			 * Fixed 5V, 3A = <0x0001912c>
			 * Fixed 9V, 500 mA = <0x0002d032>
			 * Fixed 9V, 1A = <0x0002d064>
			 * Fixed 9V, 2A = <0x0002d0c8>
			 * Fixed 9V, 3A = <0x0002d12c>
			 * Variable 5-9V, 1A = <0x8642d064>
			 * Variable 5-9V, 2A = <0x8642d0c8>
			 * Variable 5-9V, 3A = <0x8642d12c>
			 * PPS 3V ~ 5.9V, 3A = <0xC0761E3C>
			 * PPS 5V ~ 11.0V, 3A = <0xC0DC323C>
			 */
			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019032>;
			pd,sink-pdo-size = <1>;
			pd,sink-pdo-data = <0x000190c8>;
			pd,id-vdo-size = <6>;
			pd,id-vdo-data = <0xd14029cf 0x0 0x17110000 0x61000000 0x0 0x41000000>;
			bat,nr = <1>;
			pd,country_nr = <0>;
			bat-info0 {
				bat,vid = <0x29cf>;
				bat,pid = <0x1711>;
				bat,mfrs = "bat1";
				bat,design_cap = <19>;
			};
		};

		dpm_caps {
			local_dr_power;
			local_dr_data;
			local_usb_comm;
			local_no_suspend;
			local_vconn_supply;
			attempt_enter_dp_mode;
			attempt_discover_cable;
			attempt_discover_id;
			pr_check = <0>;
			dr_check = <0>;
		};

		displayport {
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			typec,receptacle;

			ufp_d {};

			dfp_d {
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
			};
		};
	};

	/* BQ charger */
	bq2589x@6a {
		compatible = "ti,bq2589x-1";
		reg = <0x6a>;
		interrupt-parent = <&tlmm>;
		interrupts = <105 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&bq2589x_int_default>;
		intr-gpios = <&tlmm 105 0>;
		usb-switch-gpios = <&tlmm 31 0>;
		ti,bq2589x,vbus-volt-high-level = <8700>;
		ti,bq2589x,vbus-volt-low-level = <4400>;
		ti,bq2589x,vbat-min-volt-to-tuneup = <3000>;
		ti,bq2589x,charge-voltage = <4450>;
		ti,bq2589x,charge-current = <2000>;
		ti,bq2589x,charge-current-1500 = <1500>;
		ti,bq2589x,charge-current-1000 = <1000>;
		ti,bq2589x,charge-current-500 = <500>;
		ti,bq2589x,charge-current-3500 = <3500>;
		ti,bq2589x,input-current-2000 = <2000>;
		ti,bq2589x,term-current = <256>;
		ti,bq2589x,enable-auto-dpdm;
		ti,bq2589x,enable-termination;
		ti,bq2589x,enable-ico;
		ti,bq2589x,use-absolute-vindpm;
	};

	/* Fuel gauge */
	sm5602@71 {
		compatible = "sm,sm5602";
		reg = <0x71>;
		sm,en_temp_ex;
		sm,en_batt_det;
		sm,misc = <2048>;
		sm,aging_ctrl = <289>;
		sm,cycle_cfg = <28672>;
		sm,rsns = <0>;
		sm,fg_irq_set = <2047>;
		sm,low_soc1 = <1>;
		sm,low_soc2 = <15>;
		sm,v_l_alarm = <3400>;
		sm,v_h_alarm = <4450>;
		sm,battery_table_num = <0>;
		sm,param_version = <5>;
		sm,t_l_alarm_in = <54>;
		sm,t_h_alarm_in = <1>;
		sm,t_l_alarm_ex = <54834>;
		sm,t_h_alarm_ex = <38239>;
		sm,shutdown-delay-enable;
		sm,rtrace = <7300>;
		sm,soc_decimal_rate = <0 38 10 35 20 33 30 33 40 33 50 33 60 33 70 30 80 25 90 20 95 10>;

		battery_params {
			/* battery 0 */
			battery0,param_version = <10>;
			battery0,max_voltage_uv = <4450000>;
			battery0,battery_type = <4450 0 9932>;
			battery0,battery_table0 = <5120 6966 7259 7437 7517 7550 7565 7575 7617 7664 7706 7754 7786 7842 7918 7991 8121 8213 8313 8424 8604 8791 9041 9420>;
			battery0,battery_table1 = <0 102 490 879 1138 1396 2044 2820 3597 4632 5927 7221 8515 10457 12398 13692 14987 16281 17575 18869 20811 22752 25600 25830>;
			battery0,battery_table2 = <5664 4371 3856 3342 3084 2827 2570 2570>;
			battery0,alpha = <204>;
			battery0,beta = <37>;
			battery0,rs = <95>;
			battery0,rs_value = <80 266 14336 72>;
			battery0,vit_period = <12890>;
			battery0,volt_cal = <32768>;
			battery0,mix_value = <3>;
			battery0,curr_offset = <0>;
			battery0,curr_slope = <32896>;
			battery0,topoff_soc = <7 300 100>;
			battery0,temp_std = <25>;
			battery0,temp_offset = <0 11 1 0 8 (-1)>;
			battery0,temp_cal = <0 6 1 11 (-1) 0 6 1 9 1>;
			battery0,ext_temp_cal = <0 2 1 2 1 1 2 7 2 9>;
			battery0,tempoff = <3400 100>;
			battery0,fcm_offset = <64>;
			battery0,thermal_table = <40261 40191 40119 40045 39971 39898 39826 39758 39692 39632 39577 39529 39487 39449 39414 39379 39344 39307 39265 39217 39162 39093 39009 38911 38803 38688 38569 38449 38331 38217 38112 38012 37913 37816 37719 37622 37527 37432 37338 37244 37150 37058 36969 36882 36796 36710 36622 36532 36439 36342 36240 36130 36010 35884 35754 35621 35487 35356 35228 35106 34992 34886 34785 34688 34594 34502 34410 34317 34223 34125 34023 33921 33824 33728 33631 33531 33425 33310 33184 33045 32890 32684 32408 32081 31720 31345 30976 30630 30327 30085 29924 29819 29730 29654 29588 29529 29473 29416 29357 29290 29213 29126 29032 28933 28830 28725 28619 28513 28409 28309 28213 28122 28033 27946 27861 27777 27693 27609 27524 27437 27349 27259 27167 27074 26980 26886 26792 26698 26605 26513 26422 26333 26246 26160 26075 25990 25905 25819 25732 25643 25551 25456 25358 25258 25156 25053 24950 24849 24748 24651 24556 24463 24371 24280 24190 24101 24013 23928 23846 23766 23689 23615 23544 23476 23409 23344 23280 23217 23153 23090 23026 22963 22902 22843 22784 22725 22665 22603 22538 22471 22399 22321 22235 22144 22048 21951 21853 21757 21663 21574 21492 21414 21336 21260 21185 21113 21043 20976 20913 20853 20798 20748 20704 20663 20625 20588 20550 20511 20469 20422 20369 20307 20233 20152 20064 19973 19881 19791 19704 19624 19553 19489 19428 19371 19315 19262 19209 19157 19105 19053 18999 18945 18892 18839 18786 18733 18680 18627 18573 18518 18462 18405 18348 18290 18232 18173 18113 18052 17989 17925 17859 17790 17716 17640 17562 17482 17403 17324 17248 17174 17104 17037 16973 16910 16848 16787 16727 16668 16609 16549 16489 16429 16368 16308 16249 16189 16130 16070 16012 15953 15895 15837 15780 15722 15665 15609 15552 15496 15440 15384 15329 15274 15219 15165 15110 15057 15003 14949 14896 14843 14790 14737 14685 14632 14580 14528 14476 14425 14374 14323 14272 14222 14171 14121 14072 14022 13973 13924 13876 13827 13779 13731 13684 13636 13589 13543 13496 13450 134