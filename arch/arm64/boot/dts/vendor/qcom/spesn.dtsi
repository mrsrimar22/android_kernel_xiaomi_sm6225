	onewire_gpio: onewire_gpio {
		compatible = "xiaomi,onewire_gpio";
		label = "xm_onewire";
		xiaomi,onewire-gpios = <&tlmm 108 GPIO_ACTIVE_HIGH>;
		xiaomi,onewire-cfg-addr = <0x96c000 0x04>;
		pinctrl-names = "onewire_active", "onewire_sleep";
		pinctrl-0 = <&onewire_gpio_active>;
		pinctrl-1 = <&onewire_gpio_sleep>;
		status = "okay";
	};

	maxim_ds28e16: maxim_ds28e16 {
		compatible = "maxim,ds28e16";
		label = "max_ds28e16";
		xiaomi,onewire-bus = "xm_onewire";
		status = "okay";
	};

	cp_manager: cp_manager {
		compatible = "xiaomi,cp_manager";
		label = "cp_manager";
		fc2_disable_sw;
		bat_volt_lp_lmt = <4450>;
		bat_curr_lp_lmt = <5800>;
		bus_volt_lp_lmt = <12000>;
		bus_curr_lp_lmt = <2900>;
